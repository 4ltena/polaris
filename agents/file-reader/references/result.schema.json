{
  "type": "object",
  "additionalProperties": false,
  "required": ["markdown"],
  "properties": {
    "markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "^# [^\\n]+\\n(?:- `[^`\\n]+` [—-] 処理: [^\\n]+ [/／] 接続: [^\\n]+\\n)*(?:## 回答\\n(?:- `[^`\\n]+:[0-9]+` [—-] [^\\n]+\\n){1,4})?(?:## 未読\\n(?:- `[^`\\n]+`: [^\\n]+\\n){1,10})?$"
    }
  }
}
